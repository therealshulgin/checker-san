<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Distinct from CheckerSan.exe: Windows file names ignore case, and both ship in the same folder. -->
    <AssemblyName>checkersan-cli</AssemblyName>
    <RootNamespace>FolderChecker.Cli</RootNamespace>
    <Product>Checker San</Product>
    <Version>1.0.0</Version>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Same long-path declaration as the app: paths beyond 260 characters where Windows allows them. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../FolderChecker.Core/FolderChecker.Core.csproj" /></ItemGroup>
</Project>
